# Messaging
TELEGRAM_BOT_TOKEN=

# LLM + design tooling
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
EXECUTION_MODEL=claude-sonnet-4-5-20250929
EXECUTION_MAX_THINKING_TOKENS=2048
INTERACTION_MODEL=claude-opus-4-6
INTERACTION_MAX_THINKING_TOKENS=4096
INTERACTION_AGENT_ROUTING_MAX_RETRIES=8
INTERACTION_SESSION_CACHE_DIR=./data/interaction_sessions
CLAUDE_ENABLE_TOOL_SEARCH=true
CLAUDE_ENABLE_MEMORY_TOOL=true
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Unsplash
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APP_ID=

# Chrome DevTools MCP (browser automation)
CHROME_DEVTOOLS_MCP_ENABLED=false
CHROME_DEVTOOLS_MCP_PROFILE_DIR=./chrome_profiles
CHROME_DEVTOOLS_MCP_COMMAND=bunx
CHROME_DEVTOOLS_MCP_PACKAGE=chrome-devtools-mcp@latest
CHROME_DEVTOOLS_MCP_HEADLESS=true
CHROME_DEVTOOLS_MCP_EXECUTABLE_PATH=

# Vercel
VERCEL_TOKEN=
VERCEL_SCOPE=

# GitHub App (org-owned repos)
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO_PREFIX=site
GITHUB_REPO_VISIBILITY=private

# Public base URL (used for Stripe success/cancel URLs)
PUBLIC_BASE_URL=

# Events
EVENT_URL=
EVENTS_SIGNING_SECRET=
EVENTS_REQUIRE_SIGNATURE=true

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Docker pool paths (for docker runtime on host)
# Local dev defaults:
HOST_DATA_PATH=./data
CONTAINER_DATA_PATH=/app/data
DOCKER_POOL_ROOT=/app/data/pool
# Production example (VM):
# HOST_DATA_PATH=/opt/demi/data
# CONTAINER_DATA_PATH=/opt/demi/data
# DOCKER_POOL_ROOT=/opt/demi/data/pool

# Billing (assistant subscription gate)
# If omitted, defaults to PUBLIC_BASE_URL + /billing/status
BILLING_STATUS_URL=
BILLING_STATUS_TOKEN=

# Assistant subscription price
ASSISTANT_STRIPE_PRICE_ID=
ASSISTANT_PRODUCT_NAME=Hire me
ASSISTANT_PRICE_USD=50
ASSISTANT_CURRENCY=USD

# Main DB (Supabase/Postgres)
# Runtime (Supabase client)
MAIN_DB_SUPABASE_URL=
MAIN_DB_SUPABASE_SERVICE_KEY=
# Migration helper (direct Postgres connection)
# DEMI_MAIN_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DEMI_SQLITE_PATH=./data/main.sqlite

# Supabase (shared org)
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_SLUG=
SUPABASE_ORG_ID=
SUPABASE_REGION_SELECTION=americas
SUPABASE_REGION=
SUPABASE_INSTANCE_SIZE=micro
SUPABASE_PROJECT_PREFIX=site
